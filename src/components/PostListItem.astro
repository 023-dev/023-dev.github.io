---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import { getPostExcerpt } from "../utils/postExcerpt";
import { getReadingTime } from "../utils/readingTime";

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const tags = post.data.tags ?? [];
const primaryTag = tags[0] ?? "Post";
const excerpt = getPostExcerpt(post.body);
---

<li class="post-card">
	<a href={`/blog/${post.slug}/`} class="post-card__link">
		<div class="post-card__media">
			{
				post.data.heroImage ? (
					<Image src={post.data.heroImage} alt={post.data.title} />
				) : (
					<div class="post-card__placeholder">
						<span>{primaryTag}</span>
					</div>
				)
			}
		</div>

		<div class="post-card__body">
			<h2 class="post-card__title">{post.data.title}</h2>
			<p class="post-card__excerpt">{excerpt}</p>
			<div class="post-card__meta">
				<FormattedDate date={post.data.date} />
				<span aria-hidden="true">·</span>
				<span>{getReadingTime(post.body)}</span>
			</div>
			{tags.length > 0 && <span class="post-card__tag">{primaryTag}</span>}
		</div>
	</a>
</li>
