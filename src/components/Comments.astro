<section class="utterances mx-auto mt-10 w-full">
    <div class="loading-msg text-center text-gray-400 py-10">
        댓글을 불러오는 중입니다...
    </div>
</section>

<script>
    const repo = "023-dev/023-dev.github.io";
    const commentsSelector = "section.utterances";
    const utterancesSrc = "https://utteranc.es/client.js";

    const getTheme = () => {
        return document.documentElement.classList.contains("dark")
            ? "github-dark"
            : "github-light";
    };

    const createUtterances = () => {
        const container = document.querySelector<HTMLElement>(commentsSelector);
        if (!container || container.dataset.utterancesInitialized === "true") {
            return;
        }

        if (container.querySelector("iframe, script")) {
            container.dataset.utterancesInitialized = "true";
            return;
        }

        container.dataset.utterancesInitialized = "true";
        container.querySelector(".loading-msg")?.remove();
        const script = document.createElement("script");
        script.src = utterancesSrc;
        script.setAttribute("repo", repo);
        script.setAttribute("issue-term", "pathname");
        script.setAttribute("label", "comment");
        script.setAttribute("theme", getTheme());
        script.setAttribute("crossorigin", "anonymous");
        script.async = true;
        script.onerror = () => {
            container.dataset.utterancesInitialized = "false";
            container.innerHTML =
                '<div class="text-center text-sm text-gray-400 py-10">댓글을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.</div>';
        };
        container.appendChild(script);
    };

    createUtterances();
    document.addEventListener("astro:page-load", createUtterances);

    // Theme sync logic
    const updateUtterancesTheme = () => {
        const theme = getTheme();
        const iframe =
            document.querySelector<HTMLIFrameElement>(`${commentsSelector} iframe`);

        if (iframe) {
            const message = {
                type: "set-theme",
                theme: theme,
            };
            iframe.contentWindow?.postMessage(message, "https://utteranc.es");
        }
    };

    const observer = new MutationObserver(updateUtterancesTheme);
    observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
    });
</script>
