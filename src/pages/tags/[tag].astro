---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostListItem from "../../components/PostListItem.astro";

export async function getStaticPaths() {
	const allPosts = (await getCollection("blog")).filter(
		(post) => post.data.visible !== false,
	);
	const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags ?? []))].sort();

	return allTags.map((tag) => ({
		params: { tag: tag.toLowerCase() },
		props: {
			tag,
			allTags,
			posts: allPosts
				.filter((post) => post.data.tags?.includes(tag))
				.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
		},
	}));
}

const { tag, posts, allTags } = Astro.props;
const activeTag = tag.toLowerCase();
---

<BaseLayout title={`Posts tagged with ${tag}`} wide={true}>
	<section class="blog-archive">
		<p class="page-kicker">BLOG / TOPIC</p>
		<div class="archive-header">
			<div>
				<h1 class="page-title">{tag}</h1>
				<p class="page-lede">{tag}에 관한 023 DEV의 기록입니다.</p>
			</div>
			<p class="archive-count">{posts.length} posts</p>
		</div>

		<nav class="archive-toolbar" aria-label="주제 필터">
			<a href="/blog" class="topic-chip">All posts</a>
			{allTags.map((tagItem) => (
				<a
					href={`/tags/${tagItem.toLowerCase()}`}
					class={tagItem.toLowerCase() === activeTag ? "topic-chip is-active" : "topic-chip"}
					aria-current={tagItem.toLowerCase() === activeTag ? "page" : undefined}
				>
					{tagItem}
				</a>
			))}
		</nav>

		<ul class="post-list">
			{posts.map((post) => <PostListItem post={post} />)}
		</ul>
	</section>
</BaseLayout>
