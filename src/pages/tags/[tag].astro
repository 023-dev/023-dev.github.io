---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostListItem from "../../components/PostListItem.astro";

export async function getStaticPaths() {
    const allPosts = (await getCollection("blog")).filter(
        (post) => post.data.visible !== false,
    );
    const uniqueTags = [
        ...new Set(allPosts.map((post) => post.data.tags).flat()),
    ];

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts
            .filter((post) => post.data.tags.includes(tag))
            .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

        return {
            params: { tag: tag.toLowerCase() },
            props: { posts: filteredPosts, tag },
        };
    });
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Posts tagged with ${tag}`} wide={true}>
    <section class="pb-6 pt-12 md:pb-8 md:pt-16">
        <p class="mb-4 text-xs font-bold uppercase tracking-wider text-gray-500">
            Tag
        </p>
        <h1 class="font-heading text-[44px] font-bold leading-none tracking-tight capitalize md:text-[56px]">
            {tag}
        </h1>
        <p class="mt-5 text-[18px] leading-[28px] text-[#555]">
            {posts.length} posts
        </p>
    </section>

    <section class="pb-16 pt-4 md:pt-6">
        <ul>
            {posts.map((post) => <PostListItem post={post} />)}
        </ul>
    </section>
</BaseLayout>
