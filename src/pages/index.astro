---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import PostListItem from "../components/PostListItem.astro";

const posts = (await getCollection("blog"))
    .filter((post) => post.data.visible !== false)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tags = [
    ...new Set(posts.flatMap((post) => post.data.tags ?? [])),
].sort();
---

<BaseLayout title="Astro Tech Blog" wide={true}>
    <section class="pb-6 pt-12 md:pb-8 md:pt-16">
        <div>
            <p class="mb-4 text-xs font-bold uppercase tracking-wider text-gray-500">
                Tech Blog
            </p>
            <h1 class="font-heading text-[44px] font-bold leading-none tracking-tight md:text-[56px]">
                Engineering
            </h1>
            <p class="mt-5 max-w-[560px] text-[18px] leading-[28px] text-[#555]">
                The technology behind My Engineering
            </p>
        </div>
    </section>

    <section class="grid gap-10 pb-16 pt-4 md:pt-6 lg:grid-cols-[minmax(0,1fr)_260px]">
        <div>
            <div class="mb-2 flex items-baseline justify-between">
                <h2 class="text-[24px] font-bold tracking-tight">전체 게시글</h2>
                <span class="text-sm font-medium text-gray-500">{posts.length} posts</span>
            </div>
            <ul>
                {posts.map((post) => <PostListItem post={post} />)}
            </ul>
        </div>

        <aside class="self-start border-t border-gray-200 pt-6 lg:sticky lg:top-24">
            <h2 class="mb-4 text-[18px] font-bold tracking-tight">Tag</h2>
            <div class="flex flex-wrap gap-2">
                {
                    tags.map((tag) => (
                        <a
                            href={`/tags/${tag.toLowerCase()}`}
                            class="rounded-full bg-[rgb(246,246,246)] px-3 py-1.5 text-sm font-medium text-[#555] transition-colors hover:bg-black hover:text-white"
                        >
                            {tag}
                        </a>
                    ))
                }
            </div>
        </aside>
    </section>
</BaseLayout>
