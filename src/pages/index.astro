---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import PostListItem from "../components/PostListItem.astro";

const posts = (await getCollection("blog"))
    .filter((post) => post.data.visible !== false)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tags = [
    ...new Set(posts.flatMap((post) => post.data.tags ?? [])),
].sort();
---

<BaseLayout title="Astro Tech Blog" wide={true}>
    <section class="grid gap-10 pb-16 lg:grid-cols-[minmax(0,1fr)_260px]">
        <div>
            <ul>
                {posts.map((post) => <PostListItem post={post} />)}
            </ul>
        </div>

        <aside class="self-start lg:sticky lg:top-24">
            <h2 class="mb-4 text-[18px] font-bold tracking-tight">Tag</h2>
            <div class="flex flex-wrap gap-2">
                {
                    tags.map((tag) => (
                        <a
                            href={`/tags/${tag.toLowerCase()}`}
                            class="rounded-full bg-[rgb(246,246,246)] px-3 py-1.5 text-sm font-medium text-[#555] transition-colors hover:bg-black hover:text-white"
                        >
                            {tag}
                        </a>
                    ))
                }
            </div>
        </aside>
    </section>
</BaseLayout>
