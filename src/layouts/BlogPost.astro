---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Comments from "../components/Comments.astro";
import TableOfContents from "../components/TableOfContents.astro";

type Props = CollectionEntry<"blog">["data"] & {
	headings?: MarkdownHeading[];
	previousPost?: { href: string; title: string };
	nextPost?: { href: string; title: string };
	readingTime?: string;
};

const { title, date, headings, previousPost, nextPost, readingTime, heroImage, tags } =
	Astro.props;
const hasTableOfContents = headings?.some((heading) => heading.depth <= 3) ?? false;
const slug = Astro.url.pathname.replace(/^\/blog\/|\/$/g, "");
const ogImage = `/og/${slug}.png`;
---

<BaseLayout title={title} wide={true} image={ogImage}>
	<article class="article-page">
		<div class="article-layout">
			<div class="article-main">
		<header class="article-header">
			<a href="/blog" class="article-back">← All posts</a>
			<p class="article-kicker">Blog / {tags?.[0] ?? "Note"} / Article</p>
			<h1 class="article-title" data-pagefind-meta="title">{title}</h1>

			<div style="display: none">
				{heroImage && (
					<meta
						data-pagefind-meta="heroImage[content]"
						content={typeof heroImage === "string" ? heroImage : heroImage.src}
					/>
				)}
				{date && <meta data-pagefind-meta="date[content]" content={date.toISOString()} />}
				{tags?.map((tag) => <meta data-pagefind-meta="tag" content={tag} />)}
			</div>

			<div class="article-meta">
				<FormattedDate date={date} />
				{readingTime && <><span>/</span><span>{readingTime}</span></>}
				<span>/</span>
				<span id="view-count" aria-live="polite">0</span>
				<span>views</span>
			</div>
		</header>

		{
			heroImage ? (
				<Image src={heroImage} alt="" class="article-hero" />
			) : (
				<div class="article-hero article-hero--placeholder" aria-hidden="true">
					<span>023 DEV / NOTE</span>
				</div>
			)
		}

		{
			hasTableOfContents && (
				<details class="article-mobile-toc">
					<summary>On this page</summary>
					<div><TableOfContents headings={headings ?? []} /></div>
				</details>
			)
		}

			<div class="article-content">
				<div class="prose" data-pagefind-body>
					<slot />
				</div>

				{
					(previousPost || nextPost) && (
						<nav class="post-navigation" aria-label="Post navigation">
							{previousPost ? (
								<a href={previousPost.href}>
									<span class="post-navigation__label">Previous</span>
									<span class="post-navigation__title">{previousPost.title}</span>
								</a>
							) : <span />}
							{nextPost ? (
								<a href={nextPost.href}>
									<span class="post-navigation__label">Next</span>
									<span class="post-navigation__title">{nextPost.title}</span>
								</a>
							) : <span />}
						</nav>
					)
				}

				<Comments />
			</div>
			</div>

			{
				hasTableOfContents && (
					<aside class="article-toc" aria-label="On this page">
						<TableOfContents headings={headings ?? []} />
						<button class="article-copy-page" type="button" data-copy-page>
							<svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
								<rect x="5.25" y="2.25" width="8.5" height="8.5" rx="1.25" stroke="currentColor" stroke-width="1.4" />
								<path d="M3.5 5.25H3A1.5 1.5 0 0 0 1.5 6.75V13A1.5 1.5 0 0 0 3 14.5h6.25A1.5 1.5 0 0 0 10.75 13v-.5" stroke="currentColor" stroke-width="1.4" />
							</svg>
							<span data-copy-page-label>Copy Page</span>
						</button>
					</aside>
				)
			}
		</div>
	</article>
</BaseLayout>

<script>
	document.addEventListener("astro:page-load", () => {
		const viewCountElement = document.getElementById("view-count");
		if (!viewCountElement) return;

		const slug = window.location.pathname.replace(/^\/blog\/|\/$/g, "");
		fetch(`/api/views/${slug}`)
			.then((response) => response.json())
			.then((data) => {
				viewCountElement.textContent = data.views.toLocaleString();
			})
			.catch(() => {
				viewCountElement.textContent = "0";
			});

		const copyPageButton = document.querySelector<HTMLButtonElement>("[data-copy-page]");
		if (!copyPageButton || copyPageButton.dataset.bound === "true") return;

		copyPageButton.dataset.bound = "true";
		const copyPageLabel = copyPageButton.querySelector<HTMLElement>("[data-copy-page-label]");
		const initialCopyLabel = copyPageLabel?.textContent ?? "Copy Page";

		copyPageButton.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				if (copyPageLabel) copyPageLabel.textContent = "Copied";
				window.setTimeout(() => {
					if (copyPageLabel) copyPageLabel.textContent = initialCopyLabel;
				}, 1400);
			} catch {
				if (copyPageLabel) copyPageLabel.textContent = "Copy failed";
			}
		});
	});
</script>
