---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/react/Header.jsx";
import Footer from "../components/Footer.astro";
import VisitorMonitor from "../components/react/VisitorMonitor.jsx";
import BlogSidebar from "../components/BlogSidebar.astro";
import { getCollection } from "astro:content";

import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	image?: string;
	wide?: boolean;
}

const { title, description, image, wide = false } = Astro.props;
const posts = (await getCollection("blog"))
	.filter((post) => post.data.visible !== false)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort();
const recentPosts = posts.map((post) => ({ slug: post.slug, title: post.data.title }));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<slot name="head" />
		<ClientRouter />
	</head>
	<body>
		<Header client:load />
		<div class="site-body">
			<BlogSidebar tags={tags} recentPosts={recentPosts} />
			<main class={`site-main ${wide ? "" : "site-main--compact"}`}>
				<slot />
			</main>
		</div>
		<Footer />
		<VisitorMonitor client:idle />
	</body>
</html>
